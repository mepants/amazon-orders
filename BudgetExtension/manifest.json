{
  "manifest_version": 3,
  "name": "Craig's Budget Parse",
  "version": "1.0",
  "description": "Parse web pages for budget data",
  "permissions": [
    "tabs",
    "scripting",
    "declarativeContent",
    "storage"
  ],
  "host_permissions": [
    "https://www.amazon.co.uk/*",
    "https://online.sainsburysbank.co.uk/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/get_started16.png",
      "32": "images/get_started32.png",
      "48": "images/get_started48.png",
      "128": "images/get_started128.png"
    }
  },
  "icons": {
    "16": "images/get_started16.png",
    "32": "images/get_started32.png",
    "48": "images/get_started48.png",
    "128": "images/get_started128.png"
  }
}